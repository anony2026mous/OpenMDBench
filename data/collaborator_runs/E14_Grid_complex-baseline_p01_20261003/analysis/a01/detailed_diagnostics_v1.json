    "reward_source": "    def compute_reward(self, role: str = \"blue\") -> float:\n        \"\"\"Compute per-step reward for the given role.\n\n        Uses DELTAS of cumulative metrics (not cumulative values)\n        so the RL signal is meaningful per step.\n\n        v2 additions (H.5): +2 scout tracked >20 consecutive steps,\n        -10 dynamic-obstacle collision, -0.1 static-obstacle bump,\n        -0.01/step time penalty.\n        \"\"\"\n        if role == \"blue\":\n            reward = 0.0\n\n            # Sparse terminal rewards\n            if self.done:\n                if self.winner == \"blue\":\n                    reward += 100.0\n                elif self.winner == \"red\":\n                    reward -= 100.0\n                else:\n                    # v2.1.4: draw (no penetration, no interception, time\n                    # limit) pays — stalling was a safe partial-credit\n                    # attractor (win 0% with ret ≈ -13 via detection/\n                    # tracking bonuses). Interception-win (+100) must\n                    # strictly dominate draw (-60) which must dominate\n                    # leaked-loss (-100 - 40/leak).\n                    reward -= 60.0\n\n            # Per-step deltas of cumulative metrics\n            reward -= 50.0 * (self.metrics[\"civilian_intercepted\"] - self._prev_metrics.get(\"civilian_intercepted\", 0))\n            # v2.1 deception: firing on a friendly transport wastes\n            # intercept capacity on a feint — own-goal penalty between\n            # civilian hit (-50) and blue loss (-20).\n            reward -= 30.0 * (self.metrics[\"neutral_intercepted\"] - self._prev_metrics.get(\"neutral_intercepted\", 0))\n            # v2.1.4 shaping: per-event penetration penalty. Without it the\n            # only pressure toward zero-penetration is the terminal ±100\n            # cliff; curriculum runs plateau at \"intercept 3, leak 1\"\n            # (partial-credit local optimum). The penalty fires at the\n            # moment of the leak (direct credit assignment) and does not\n            # alter the optimal policy set (penetration is 0 in any\n            # optimal trajectory) nor the evaluation metric (mission_success).\n            reward -= 40.0 * (self.metrics[\"red_units_entered_port\"] - self._prev_metrics.get(\"red_units_entered_port\", 0))\n            reward -= 20.0 * (self.metrics[\"blue_units_lost\"] - self._prev_metrics.get(\"blue_units_lost\", 0))\n            reward += 1.0 * (self.metrics[\"red_detected\"] - self._prev_metrics.get(\"red_detected\", 0))\n            reward += 5.0 * (self.metrics[\"red_intercepted\"] - self._prev_metrics.get(\"red_intercepted\", 0))\n            reward += 2.0 * (self.metrics[\"scout_track_bonuses\"] - self._prev_metrics.get(\"scout_track_bonuses\", 0))\n            reward -= DYN_OBSTACLE_PENALTY * (self.metrics[\"dyn_obstacle_collisions\"] - self._prev_metrics.get(\"dyn_obstacle_collisions\", 0))\n            reward -= STATIC_BUMP_PENALTY * (self.metrics[\"static_obstacle_bumps\"] - self._prev_metrics.get(\"static_obstacle_bumps\", 0))\n\n            # Tracking bonus (per step of continuous tracking)\n            for red_id in self.red_units:\n                red = self.entities[red_id]\n                if red.detected and red.alive and red.tracked_steps > 0:\n                    reward += 0.5\n\n            # Time penalty (H.5 v2: -0.01/step)\n            reward -= 0.01\n\n            # Update previous metrics snapshot\n            self._prev_metrics = dict(self.metrics)\n\n            return reward\n\n        else:  # red\n            reward = 0.0\n            if self.done:\n                if self.winner == \"red\":\n                    reward += 100.0\n                elif self.winner == \"blue\":\n                    reward -= 100.0\n            reward -= 10.0 * sum(1 for uid in self.red_units if not self.entities[uid].alive)\n            reward += 15.0 * self.metrics[\"blue_units_lost\"]\n            reward += 5.0 * self.metrics[\"red_units_entered_port\"]\n            reward -= 0.01\n            return reward\n",
