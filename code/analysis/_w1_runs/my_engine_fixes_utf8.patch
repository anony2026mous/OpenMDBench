@@ -4,6 +4,28 @@ from __future__ import annotations
 
 import math
 
+# ---------------------------------------------------------------------------
+# Sim2Sea MMG propeller-rate scale.
+#
+# The trusted MMG solver consumes ``nps`` as propeller revolutions per second:
+# ``X_P = (1 - t_P) * rho * K_T * nps**2 * D_p**4`` with advance ratio
+# ``J = (1 - w_P) * u / (nps * D_p)`` (``env/vessel_sim.py``).  The calibrated
+# hull is the 1/45.7-scale KVLCC2 (``env/calibrated_vessels.py:kvlcc2_l7``,
+# ``Lpp = 7.0 m``, ``D_p = 0.204 m``), so its physical prop-rate band is far
+# above the small placeholder cap that used to be hard-coded in the dynamics,
+# controller, and worker modules.
+#
+# Calibration reference: 200 NPS <-> 15 m/s, i.e. ~13.33 NPS per m/s.  The
+# trusted band therefore spans the solver's own trusted maximum speed
+# (12.9 m/s ~ 172 NPS) with margin, which makes it self-consistent with
+# ``algorithm_limits[MMG]["max_speed_mps"] = 12.9``.
+#
+# This is only an upper *bound*: a resource still declares its own ``max_nps``
+# (the prop rate at its ``max_speed_mps``), so resources declaring
+# ``max_nps <= 5.0`` keep their previous behaviour exactly.
+MMG_NPS_PER_MPS = 200.0 / 15.0
+MMG_TRUSTED_MAX_NPS = 200.0
+
 
 def degrees_to_radians(degrees: float) -> float:
     """Convert degrees to radians."""
