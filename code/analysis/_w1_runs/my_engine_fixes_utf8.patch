             target_heading_deg=0.0,
             parameters=parameters,
         )
+
+
+def test_navigation_accepts_a_calibrated_propeller_rate_profile() -> None:
+    """A resource may declare the prop rate that reaches its own max speed.
+
+    The Sim2Sea MMG solver consumes NPS directly, so a 10 m/s hull declares
+    ``max_nps = 133.33`` (200 NPS <-> 15 m/s).  Rejecting that profile made
+    every surface vessel crawl at ~0.30 m/s instead of its commanded speed.
+    """
+    action = mmg_navigation_action_v2(
+        current_heading_deg=0.0,
+        target_speed_mps=10.0,
+        target_heading_deg=90.0,
+        parameters={**_PARAMETERS, "max_speed_mps": 10.0,
+                    "max_nps": 133.33333333333334},
+    )
+    assert action.nps == pytest.approx(133.33333333333334)
+    assert action.rudder_rad == pytest.approx(-0.3)
