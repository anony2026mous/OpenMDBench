schema_version: package@2.0
scenario:
  schema_version: "2.0"
  scenario_id: md-int-002.air-surface.v2
  display_name: MD-INT-002 Air-Surface Joint Assault
  factions:
    - {schema_version: "2.0", id: coalition.defender, display_name: Defender}
    - {schema_version: "2.0", id: coalition.intruder, display_name: Intruder}
  relationships:
    - {schema_version: "2.0", source_faction_id: coalition.defender, target_faction_id: coalition.intruder, relation: hostile}
    - {schema_version: "2.0", source_faction_id: coalition.intruder, target_faction_id: coalition.defender, relation: hostile}
  entities:
    - schema_version: "2.0"
      id: defender.interceptor-001
      faction_id: coalition.defender
      platform_ref: platform.interceptor-uav@2.0.0
      dynamics_ref: dynamics.interceptor-uav@2.0.0
      loadout_ref: loadout.interceptor-uav@2.0.0
      component_refs: [sensor.interceptor-radar@2.0.0, sensor.interceptor-eo@2.0.0, communication.command-network@2.0.0]
      ammunition: {ammunition.interceptor-missile@2.0.0: 6}
      target_domains: [air]
      initial_state: {schema_version: "2.0", position_m: [8000.0, -4000.0, 800.0], velocity_mps: [0.0, 0.0, 0.0], heading_deg: 90.0, health: 1.0, energy: 1.0}
      controller_slot: controller.defender.interceptor-001
      tags: [defence, interceptor]
    - schema_version: "2.0"
      id: defender.interceptor-002
      faction_id: coalition.defender
      platform_ref: platform.interceptor-uav@2.0.0
      dynamics_ref: dynamics.interceptor-uav@2.0.0
      loadout_ref: loadout.interceptor-uav@2.0.0
      component_refs: [sensor.interceptor-radar@2.0.0, sensor.interceptor-eo@2.0.0, communication.command-network@2.0.0]
      ammunition: {ammunition.interceptor-missile@2.0.0: 6}
      target_domains: [air]
      initial_state: {schema_version: "2.0", position_m: [8000.0, 4000.0, 800.0], velocity_mps: [0.0, 0.0, 0.0], heading_deg: 90.0, health: 1.0, energy: 1.0}
      controller_slot: controller.defender.interceptor-002
      tags: [defence, interceptor]
    - schema_version: "2.0"
      id: defender.picket-001
      faction_id: coalition.defender
      platform_ref: platform.picket-usv@2.0.0
      dynamics_ref: dynamics.picket-usv@2.0.0
      component_refs: [sensor.picket-radar@2.0.0, communication.command-network@2.0.0]
      target_domains: [air]
      initial_state: {schema_version: "2.0", position_m: [14000.0, 0.0, 0.0], velocity_mps: [0.0, 0.0, 0.0], heading_deg: 90.0, health: 1.0, energy: 1.0}
      controller_slot: controller.defender.picket-001
      tags: [defence, picket]
  formations: []
  world:
    schema_version: "2.0"
    coordinate_system: local_m
    map_ref: map.weihai-local@2.0.0
    duration_ticks: 1500
    tick_seconds: 1.0
    spatial_damage_policy:
      schema_version: "2.0"
      collision_effect_ref: effect.ciws-hit@2.0.0
      magnitude_model: scaled_relative_speed
      magnitude_parameters: {scale: 0.01}
      output_unit: "1"
    roe_rules:
      - {schema_version: "2.0", id: roe.defender-engage-intruder, source_faction_id: coalition.defender, target_faction_id: coalition.intruder, relationship: hostile, engagement_permitted: true}
    zones:
      - {schema_version: "2.0", id: zone.denial, geometry_type: polygon, coordinates_m: [[-8000.0, -8000.0], [8000.0, -8000.0], [8000.0, 8000.0], [-8000.0, 8000.0]], tags: [objective, protected]}
  events:
    - {schema_version: "2.0", id: event.weather-initial, event_type: weather_change, trigger: {kind: tick, tick: 0}, priority: 1000, depends_on: [], payload: {environment_ref: environment.clear@2.0.0}}
    - {schema_version: "2.0", id: wave-1.uav-001, event_type: spawn, trigger: {kind: tick, tick: 0}, priority: 100, depends_on: [], payload: {entity: {schema_version: "2.0", id: intruder.air-001, faction_id: coalition.intruder, platform_ref: platform.interceptor-uav@2.0.0, dynamics_ref: dynamics.interceptor-uav@2.0.0, component_refs: [communication.command-network@2.0.0], initial_state: {schema_version: "2.0", position_m: [25000.0, -3000.0, 100.0], velocity_mps: [-42.0, 0.0, 0.0], heading_deg: 270.0, energy: 1.0}, tags: [intruder, air-threat]}}}
    - {schema_version: "2.0", id: wave-1.uav-002, event_type: spawn, trigger: {kind: tick, tick: 0}, priority: 99, depends_on: [], payload: {entity: {schema_version: "2.0", id: intruder.air-002, faction_id: coalition.intruder, platform_ref: platform.interceptor-uav@2.0.0, dynamics_ref: dynamics.interceptor-uav@2.0.0, component_refs: [communication.command-network@2.0.0], initial_state: {schema_version: "2.0", position_m: [25000.0, 3000.0, 100.0], velocity_mps: [-42.0, 0.0, 0.0], heading_deg: 270.0, energy: 1.0}, tags: [intruder, air-threat]}}}
    - {schema_version: "2.0", id: wave-2.air-003, event_type: spawn, trigger: {kind: tick, tick: 250}, priority: 90, depends_on: [], payload: {entity: {schema_version: "2.0", id: intruder.air-003, faction_id: coalition.intruder, platform_ref: platform.interceptor-uav@2.0.0, dynamics_ref: dynamics.interceptor-uav@2.0.0, component_refs: [communication.command-network@2.0.0], initial_state: {schema_version: "2.0", position_m: [26000.0, 0.0, 100.0], velocity_mps: [-42.0, 0.0, 0.0], heading_deg: 270.0, energy: 1.0}, tags: [intruder, air-threat]}}}
    - {schema_version: "2.0", id: event.breach-failure, event_type: mission_marker, trigger: {kind: tick, tick: 1499}, priority: 10, depends_on: [], payload: {marker_id: marker.breach-failure, zone_id: zone.denial}}
    - {schema_version: "2.0", id: event.timeout-success, event_type: mission_marker, trigger: {kind: tick, tick: 1499}, priority: 9, depends_on: [], payload: {marker_id: marker.timeout-success, zone_id: zone.denial}}
  mission_states: [state.active, state.breach-failure, state.defence-success]
  mission_rules:
    - {schema_version: "2.0", id: rule.breach-failure, priority: 100, depends_on: [], condition: {schema_version: "2.0", operator: count, selector: {schema_version: "2.0", factions: [coalition.intruder], tags: [intruder], zones: [zone.denial]}, parameters: {comparison: ">=", value: 2, zone_id: zone.denial}}, outcome: {set_state: state.breach-failure, emit_event: event.breach-failure, terminal: true, result: intruder_success, ranking: {coalition.intruder: 1, coalition.defender: 2}}}
    - {schema_version: "2.0", id: rule.timeout-success, priority: 50, depends_on: [], condition: {schema_version: "2.0", operator: time, selector: {schema_version: "2.0", factions: [coalition.defender]}, parameters: {comparison: ">=", tick: 1500}}, outcome: {set_state: state.defence-success, emit_event: event.timeout-success, terminal: true, result: defender_success, ranking: {coalition.defender: 1, coalition.intruder: 2}}}
  scoring:
    aggregation: sum
    direction: maximize
    weight_policy: normalized_sum_one
    metrics:
      - {id: score.denial, selector: {schema_version: "2.0", factions: [coalition.intruder], tags: [intruder], zones: [zone.denial]}, aggregation: count, unit: "1", direction: minimize, weight: 0.6, available: true, value: 0.0}
      - {id: score.survival, selector: {schema_version: "2.0", factions: [coalition.defender]}, aggregation: mean, unit: "1", direction: maximize, weight: 0.2, available: true, value: 1.0}
      - {id: score.efficiency, selector: {schema_version: "2.0", factions: [coalition.defender], capabilities: [weapon]}, aggregation: mean, unit: "1", direction: maximize, weight: 0.2, available: true, value: 1.0}
  score_metrics: []
  controller_policy: explicit_uncontrolled
  controller_slots:
    - {id: controller.intruder.waves, controller_id: agent.intruder, faction_id: coalition.intruder, selector: {schema_version: "2.0", factions: [coalition.intruder], tags: [intruder]}, required_capabilities: [], action_schema_ref: action-batch@2.0, observation_schema_ref: observation@2.0, exclusive: true}
    - {id: controller.defender.interceptor-001, controller_id: agent.defender.interceptor-001, faction_id: coalition.defender, selector: {schema_version: "2.0", entity_ids: [defender.interceptor-001]}, required_capabilities: [weapon], action_schema_ref: action-batch@2.0, observation_schema_ref: observation@2.0, exclusive: true}
    - {id: controller.defender.interceptor-002, controller_id: agent.defender.interceptor-002, faction_id: coalition.defender, selector: {schema_version: "2.0", entity_ids: [defender.interceptor-002]}, required_capabilities: [weapon], action_schema_ref: action-batch@2.0, observation_schema_ref: observation@2.0, exclusive: true}
    - {id: controller.defender.picket-001, controller_id: agent.defender.picket-001, faction_id: coalition.defender, selector: {schema_version: "2.0", entity_ids: [defender.picket-001]}, required_capabilities: [sensor], action_schema_ref: action-batch@2.0, observation_schema_ref: observation@2.0, exclusive: true}
  visibility:
    - {view: referee, scope: truth, allow: true}
    - {view: public, scope: public, allow: true}
    - {view: faction, faction_id: coalition.defender, scope: own_and_contacts, allow: true}
    - {view: faction, faction_id: coalition.intruder, scope: own_and_contacts, allow: true}
