# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
build/
dist/

# Virtual environments — ANCHORED to the repository root on purpose.
# An unanchored `env/` also matches `code/engine/env/`, which is engine SOURCE
# (`navigation_env.py`, `vessel_sim_env_parallel.py`); git silently skipped it.
/env/
/.venv/
/venv/
/.env/

# Test / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
htmlcov/
.coverage
# `coverage.xml` at the engine root is a stale report from a local run; the file that
# documents coverage is the test suite, not this artefact.
/coverage.xml

# Matplotlib and LaTeX build caches
.mplcache/
.home/

# Run artefacts: regenerated by the analysis scripts. Ignored by DIRECTORY, never by
# extension alone, because the same suffix names both disposable logs and released
# evidence. A global `*.jsonl` + `*.log` here silently excluded 1,486 files / 288 MB of
# real data that IS meant to ship (per-tick `events.jsonl` traces, `requests.jsonl` LLM
# calls, and batch `seed-*.log` runner logs). The release builder draws the same
# distinction; see `is_junk` in build_release.py.
/reproduce/*.log
/reproduce/*.jsonl
/reproduce/*.console.txt
/reproduce/__pycache__/
*.console.txt
*.log.lock

# Verification output is regenerated on demand by erify_*.py; it is an internal
# audit record, not release material, so it is not published.
/reproduce/*_VERIFICATION.txt
/reproduce/SECRET_SCAN.txt
/reproduce/BUILD_REPORT.json

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local environment overrides
.env
.env.*
*.local

# NOTE: these are intentionally NOT ignored, because the released numbers cannot be
# reproduced without them:
#   code/analysis/_w1_runs/rl/*.npz        policy weights pinned by the paper
#   code/analysis/_w1_runs/*.json          baseline episodes (rule-rule, rl)
#   data/grid_withheld_5seeds/episodes/    the 213 per-episode reports
#   data/**/*.jsonl                        per-tick traces (g1-fault-dose alone is 76 MB)
#   data/**/*.log                          batch runner logs the manifests account for
